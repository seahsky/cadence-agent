# Copy to .env and fill in. .env is gitignored.

# Discord bot token, from the developer portal. See issue #13 for the setup checklist.
DISCORD_BOT_TOKEN=

# OpenRouter API key, for the per-token HTTP provider.
OPENROUTER_API_KEY=

# How to invoke Claude Code headlessly. A bare `claude` resolves via PATH.
CLAUDE_CLI_PATH=claude

# Where sessions, memory and logs live.
DATA_DIR=./data

# debug | info | warn | error
LOG_LEVEL=info
